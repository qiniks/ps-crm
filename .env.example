# Copy this file to .env and fill in your real connection string.
# .env is gitignored — never commit real credentials.

# PostgreSQL connection string.
# Supabase: Project Settings → Database → Connection string.
#
# For local dev / migrations you can use the DIRECT connection (port 5432):
#   DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
#
# For serverless (Vercel) runtime, prefer the POOLER connection (port 6543):
#   DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Supabase Auth (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[project].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAIL="you@example.com"
