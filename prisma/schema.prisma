// PlayStation Club CRM — multi-tenant data model
// Dev/Prod: PostgreSQL (Supabase). Switch provider to "sqlite" for local file dev.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A PlayStation club. Everything below belongs to exactly one tenant.
model Tenant {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now())
  // Soft-delete marker: set instead of hard-deleting so historical Sessions/
  // Shifts/Reservations (Prisma cascades on Tenant→everything) survive for
  // reporting. Null = active. Archived tenants are excluded from the normal
  // club listing (see /api/clubs) but stay in the DB for the admin panel.
  archivedAt   DateTime?
  rooms        Room[]
  stations     Station[]
  customers    Customer[]
  sessions     Session[]
  memberships  Membership[]
  shifts       Shift[]
  reservations Reservation[]
  auditLogs    AuditLog[]
}

// A room inside a club (e.g. "Standard hall", "VIP room").
// Pricing lives on the room, so a VIP room can be pricier than a cheap one.
// Prices are whole minor units of local currency (som).
model Room {
  id             String    @id @default(cuid())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  name           String
  price1h        Int       @default(0) // fixed price for the 1-hour tariff
  price3h        Int       @default(0) // fixed price for the 3-hour tariff
  price5h        Int       @default(0) // fixed price for the 5-hour tariff
  openHourlyRate Int       @default(0) // per-hour rate for the "open / until done" tariff
  createdAt      DateTime  @default(now())
  // Soft-delete marker, same reasoning as Tenant.archivedAt: Room→Station
  // cascades to Session/Reservation, so archiving (not deleting) keeps a
  // room's play history intact for reports. Null = active.
  archivedAt     DateTime?
  stations       Station[]

  @@index([tenantId])
}

// A physical PlayStation placed on the room's floor plan.
// posX / posY are percentages (0..100) of the room canvas, so the layout is responsive.
model Station {
  id           String        @id @default(cuid())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId       String
  name         String
  type         String        @default("PS5") // PS4 | PS5
  status       String        @default("FREE") // FREE | BUSY | MAINTENANCE
  posX         Float         @default(50)
  posY         Float         @default(50)
  sessions     Session[]
  reservations Reservation[]

  @@index([roomId])
  @@index([tenantId])
}

// A club customer (optional on a booking).
model Customer {
  id           String        @id @default(cuid())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  name         String
  phone        String?
  balance      Int           @default(0)
  bonusPoints  Int           @default(0)
  createdAt    DateTime      @default(now())
  sessions     Session[]
  reservations Reservation[]

  @@index([tenantId])
}

// A play session / booking on a station.
// tariffKind: HOUR_1 | HOUR_3 | HOUR_5 | OPEN
// For fixed tariffs cost is set at booking and plannedEndAt is filled.
// For OPEN, cost is computed on stop from elapsed time * room.openHourlyRate.
model Session {
  id            String    @id @default(cuid())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  station       Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId     String
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId    String?
  tariffKind    String
  startedAt     DateTime  @default(now())
  plannedEndAt  DateTime?
  endedAt       DateTime?
  cost          Int       @default(0)
  status        String    @default("ACTIVE") // ACTIVE | FINISHED
  // How the finished session was paid: CASH | CARD | BALANCE (null until
  // stopped, or for sessions finished before payment tracking existed).
  // BALANCE debits the customer's prepaid Customer.balance and, like CARD,
  // never touches the cash drawer (see expectedCash() in src/lib/shifts.ts).
  paymentMethod String?
  // The cash-register shift the payment landed in (null when no shift was open).
  shift         Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId       String?

  @@index([tenantId])
  @@index([stationId])
  @@index([shiftId])
}

// A cash-register shift: a seller opens it with the cash in the drawer and
// closes it with the counted amount; expected cash is derived from the cash
// payments recorded while it was open.
model Shift {
  id          String    @id @default(cuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  openedById  String // Supabase auth.users.id — not an FK, different schema
  openedBy    String // email snapshot, shown in history even if the user is deleted
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Int       @default(0)
  // Counted at close; null while the shift is open.
  closingCash Int?
  status      String    @default("OPEN") // OPEN | CLOSED
  sessions    Session[]

  @@index([tenantId, status])
}

// An advance booking of a station for a future start time. Only fixed
// tariffs (known duration) can be reserved, so overlaps are computable.
model Reservation {
  id         String    @id @default(cuid())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  station    Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  stationId  String
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  // Free-text name for walk-ins who aren't in the customer list.
  guestName  String?
  tariffKind String // HOUR_1 | HOUR_3 | HOUR_5
  startAt    DateTime
  endAt      DateTime // startAt + tariff duration, denormalized for overlap queries
  status     String    @default("BOOKED") // BOOKED | SEATED | CANCELLED
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([stationId, status])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String // Supabase auth.users.id — not an FK, different schema
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  // OWNER | CASHIER. OWNER can manage this club's membership (invite/remove/
  // change roles); CASHIER cannot. Defaults to OWNER for backward
  // compatibility — every membership created before role tiers existed (and
  // any legacy "member" value) is treated as manage-capable, see
  // canManageMembers() in src/lib/auth/roles.ts.
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// A record of a sensitive action — who did what to what, and when. Written
// via the logAudit() helper (src/lib/audit.ts), never mutated afterwards.
// tenantId is nullable because impersonation start/stop isn't scoped to a
// club; onDelete: SetNull keeps the log entry around (with tenant context
// lost) if the tenant is later deleted, instead of cascading it away.
model AuditLog {
  id          String   @id @default(cuid())
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId    String?
  actorUserId String? // Supabase auth.users.id — not an FK, different schema
  actorEmail  String? // email snapshot, same pattern as Shift.openedBy
  action      String // e.g. "session.stop", "shift.close", "impersonation.start"
  targetType  String? // e.g. "Session", "Shift", "User"
  targetId    String?
  metadata    Json? // action-specific details, e.g. a shift's cash difference
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([action])
  @@index([createdAt])
}
